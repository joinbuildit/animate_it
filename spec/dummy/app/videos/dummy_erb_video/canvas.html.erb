<%# ERB sidecar for DummyErbVideo — the ERB equivalent of DummyMotionVideo's %>
<%# HAML canvas: an inline <style> block plus the @vars CSS-variable bag the %>
<%# engine sets per frame. %>
<style>
  .dm-box { position: absolute; top: 70px; left: 30px; width: 60px; height: 60px;
            border-radius: 12px; background: #28d2bc;
            transform: translateX(var(--box-x, 0)); opacity: var(--box-opacity, 1); }
</style>

<div class="dm-root" style="<%= @vars %>">
  <div class="dm-box"></div>
</div>
